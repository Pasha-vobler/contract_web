APP_HOST=0.0.0.0
APP_PORT=8000

# На сервере оставляйте true. Для локальной диагностики допускается false.
ZAKUPKI_VERIFY_SSL=true
# REQUESTS_CA_BUNDLE=/app/certs/organization-ca.pem

# Безопасные текущие значения ограничения частоты запросов.
ZAKUPKI_MIN_REQUEST_INTERVAL=1.2
ZAKUPKI_PROACTIVE_PAUSE_EVERY=40
ZAKUPKI_PROACTIVE_PAUSE_SECONDS=20
ZAKUPKI_BLOCK_RETRIES=3
LOG_LEVEL=INFO
